# Copy to .env (git-ignored). Dev-only defaults; use strong values in any shared environment.
DB_NAME=gestor_causas
DB_USERNAME=gestor
DB_PASSWORD=gestor
# Encrypts TOTP secrets at rest (ADR-0009): 32 random bytes in base64, e.g. `openssl rand -base64 32`.
# The dev profile has a fictitious default; any other environment must set its own.
# TOTP_ENCRYPTION_KEY=
# Shared password of the fictitious users created by the `demo` profile (ADR-0011), 12+ characters.
# Required when that profile is active; no default on purpose. Choose your own local value.
# DEMO_PASSWORD=
# Optional AI assistance (ADR-0033): a Google AI Studio key (https://aistudio.google.com/apikey).
# Leave it empty to turn the AI off for everyone. The free tier may use the texts to improve
# Google's products: fictitious data only until the legal review says otherwise.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# Behind a reverse proxy (production), set it to `native` so the login throttle and the public
# calculator's rate limit (ADR-0041) see each visitor's address instead of the proxy's. Only with a
# proxy that overwrites X-Forwarded-For: otherwise clients could spoof their address.
# SERVER_FORWARD_HEADERS_STRATEGY=native
# Backups (scripts/backup.*, docs/OPERATIONS.md): folder (default ./backups, ideally on another,
# encrypted disk) and how many backups of each database to keep.
# BACKUP_DIR=D:/copias/gestor
# BACKUP_KEEP=14
