{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Task",
      "Agent",
      "Skill",
      "TodoWrite",
      "Edit(/backend/**)",
      "Edit(/frontend/**)",
      "Edit(/docs/**)",
      "Edit(/scripts/**)",
      "Edit(/.github/**)",
      "Edit(/.agent-tmp/**)",
      "Edit(/.vscode/**)",
      "Edit(/ROADMAP.md)",
      "Edit(/CHANGELOG.md)",
      "Edit(/README.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/AGENTS.md)",
      "Edit(/docker-compose.yml)",
      "Edit(/.env.example)",
      "Edit(/.gitignore)",
      "Edit(/.editorconfig)",
      "Edit(/opencode.json)",
      "Edit(/.claude/opencode-models.txt)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git stash*)",
      "Bash(git rev-parse*)",
      "Bash(git restore*)",
      "Bash(git mv*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push origin ci/*)",
      "Bash(git push origin refactor/*)",
      "Bash(git push origin test/*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh label *)",
      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(bash scripts/*)",
      "Bash(opencode *)",
      "Bash(cd *)",
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(java -version*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker version*)",
      "Bash(curl *localhost*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(sed -n *)",
      "Bash(rm -rf .agent-tmp*)",
      "Bash(rm -rf frontend/node_modules*)",
      "Bash(rm -rf backend/target*)"
    ],
    "deny": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.env)",
      "Read(/.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge --admin*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(sudo *)",
      "Bash(setx *)",
      "Bash(*ANTHROPIC_API_KEY*)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
